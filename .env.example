# Optional. Keys can also be entered in the app (Settings page); they are stored
# encrypted on the server in data/settings.json and never sent back to the browser.
# Environment variables take precedence over keys saved in the app.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=

# Secret used to encrypt saved API keys. If unset, a random one is generated in data/.secret
APP_SECRET=

# Where projects and media are stored (default: ./data)
DATA_DIR=
